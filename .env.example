# Copy to .env before running the local stack. Never commit the filled copy.

# Postgres (cohort jobs, audit log, validation reports)
POSTGRES_USER=pretrial
POSTGRES_PASSWORD=pretrial_local_only
POSTGRES_DB=pretrial
DATABASE_URL=postgresql+asyncpg://pretrial:pretrial_local_only@postgres:5432/pretrial

# Redis (Celery broker, result backend, and the job progress pub/sub channel)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Object storage. In local dev this points at the MinIO container.
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET_SEED=pretrial-seed-data
S3_BUCKET_EXPORT=pretrial-exports
AWS_ACCESS_KEY_ID=minio_local
AWS_SECRET_ACCESS_KEY=minio_local_secret
AWS_REGION=eu-central-1

# Service to service URLs (container network names)
SYNTHECORE_URL=http://synthecore:8001
FIDELITYCHECK_URL=http://fidelitycheck:8002
FHIRLINK_URL=http://fhirlink:8003

# Browser facing URLs (host network)
NEXT_PUBLIC_SYNTHECORE_URL=http://localhost:8001
NEXT_PUBLIC_FIDELITYCHECK_URL=http://localhost:8002
NEXT_PUBLIC_FHIRLINK_URL=http://localhost:8003

# SMART on FHIR OAuth 2.0
SMART_ISSUER=https://launch.smarthealthit.org/v/r4/fhir
SMART_CLIENT_ID=pretrial-ai-local
SMART_CLIENT_SECRET=
SMART_REDIRECT_URI=http://localhost:3000/api/auth/callback
SMART_SCOPES=launch openid fhirUser offline_access patient/*.read

# Proprietary generation package. Absent in the public repo, so SyntheCore
# falls back to the marked stub generator.
SYNTHECORE_ENGINE=stub
SYNTHECORE_PRIVATE_ENGINE_DSN=
